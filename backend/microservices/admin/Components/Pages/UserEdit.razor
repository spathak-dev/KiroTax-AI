@page "/users/edit/{id:int}"
@using admin.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Edit User - KiroTax AI</PageTitle>

<div class="page-container">
    @if (user == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading user...</p>
        </div>
    }
    else
    {
        <div class="page-header">
            <h1>Edit User</h1>
            <button class="btn btn-secondary" @onclick="Cancel">
                <i class="bi bi-x-circle"></i> Cancel
            </button>
        </div>

        <div class="card">
            <div class="card-body">
                <EditForm Model="@user" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Name *</label>
                            <InputText class="form-control" @bind-Value="user.Name" placeholder="Enter full name" />
                            <ValidationMessage For="@(() => user.Name)" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email *</label>
                            <InputText type="email" class="form-control" @bind-Value="user.Email" placeholder="user@example.com" />
                            <ValidationMessage For="@(() => user.Email)" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Role *</label>
                            <InputSelect class="form-select" @bind-Value="user.Role">
                                <option value="">Select Role</option>
                                <option value="admin">Admin</option>
                                <option value="ca">CA (Chartered Accountant)</option>
                                <option value="auditor">Auditor</option>
                                <option value="client">Client</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => user.Role)" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Company</label>
                            <InputText class="form-control" @bind-Value="user.Company" placeholder="Company name (optional)" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="user.IsActive" id="isActive" />
                            <label class="form-check-label" for="isActive">
                                Active User
                            </label>
                        </div>
                        <small class="text-muted">Inactive users cannot log in to the system</small>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i> Created: @user.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                            @if (user.LastLoginDate.HasValue)
                            {
                                <span class="ms-3">Last Login: @user.LastLoginDate.Value.ToString("MMM dd, yyyy HH:mm")</span>
                            }
                        </small>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success" role="alert">
                            <i class="bi bi-check-circle-fill"></i> @successMessage
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="Cancel">
                            <i class="bi bi-x-circle"></i> Cancel
                        </button>
                        <button type="button" class="btn btn-danger ms-auto" @onclick="DeleteUser">
                            <i class="bi bi-trash"></i> Delete User
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private User? user;
    private string? errorMessage;
    private string? successMessage;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        user = await DbContext.Users.FindAsync(Id);
        
        if (user == null)
        {
            Navigation.NavigateTo("/users");
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            isSubmitting = true;
            errorMessage = null;
            successMessage = null;

            // Check if email is taken by another user
            var existingUser = await DbContext.Users
                .FirstOrDefaultAsync(u => u.Email == user!.Email && u.Id != user.Id);

            if (existingUser != null)
            {
                errorMessage = "This email is already in use by another user";
                return;
            }

            DbContext.Users.Update(user!);
            await DbContext.SaveChangesAsync();

            // Log activity
            var log = new ActivityLog
            {
                Action = "user_updated",
                Description = $"Updated user: {user.Name} ({user.Email})",
                UserId = null,
                EntityType = "User",
                EntityId = user.Id,
                Timestamp = DateTime.UtcNow,
                Icon = "person-check-fill"
            };
            DbContext.ActivityLogs.Add(log);
            await DbContext.SaveChangesAsync();

            successMessage = "User updated successfully!";
            await Task.Delay(1500);
            Navigation.NavigateTo("/users");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating user: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteUser()
    {
        if (user == null) return;

        // Prevent deleting last admin
        if (user.Role == "admin")
        {
            var adminCount = await DbContext.Users.CountAsync(u => u.Role == "admin");
            if (adminCount <= 1)
            {
                errorMessage = "Cannot delete the last admin user";
                return;
            }
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"Are you sure you want to delete user '{user.Name}'? This action cannot be undone.");

        if (!confirmed) return;

        try
        {
            DbContext.Users.Remove(user);
            await DbContext.SaveChangesAsync();

            // Log activity
            var log = new ActivityLog
            {
                Action = "user_deleted",
                Description = $"Deleted user: {user.Name} ({user.Email})",
                UserId = null,
                EntityType = "User",
                EntityId = user.Id,
                Timestamp = DateTime.UtcNow,
                Icon = "person-x-fill"
            };
            DbContext.ActivityLogs.Add(log);
            await DbContext.SaveChangesAsync();

            Navigation.NavigateTo("/users");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting user: {ex.Message}";
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/users");
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = null!;
}
