{
  "template_id": "ecommerce_invoice",
  "name": "E-commerce Invoice",
  "layout_type": "standard_invoice",
  "version": "1.0.0",
  "detection": {
    "keywords": ["Order ID", "Sold By", "Shipping Address", "Delivery"],
    "min_matches": 2,
    "layout_match": "standard_invoice",
    "confidence_threshold": 0.7
  },
  "fields": {
    "order_id": {
      "method": "regex",
      "pattern": "Order\\s+(?:ID|No)[:\\s]*(.*?)(?:\\n|$)",
      "required": true
    },
    "invoice_number": {
      "method": "regex",
      "pattern": "Invoice\\s+(?:No|Number)[:\\s]*(.*?)(?:\\n|$)",
      "required": true
    },
    "order_date": {
      "method": "regex",
      "pattern": "Order\\s+Date[:\\s]*(\\d{1,2}[/-]\\d{1,2}[/-]\\d{2,4})",
      "required": true
    },
    "invoice_date": {
      "method": "regex",
      "pattern": "Invoice\\s+Date[:\\s]*(\\d{1,2}[/-]\\d{1,2}[/-]\\d{2,4})",
      "required": false
    },
    "seller_name": {
      "method": "regex",
      "pattern": "Sold\\s+By[:\\s]*(.*?)(?:\\n|GSTIN)",
      "aliases": ["Seller", "Merchant"],
      "required": true
    },
    "seller_gstin": {
      "method": "regex",
      "pattern": "Seller\\s+GSTIN[:\\s]*(\\d{2}[A-Z]{5}\\d{4}[A-Z]{1}\\d{1}[A-Z]{1}\\d{1})",
      "required": false
    },
    "shipping_address": {
      "method": "regex",
      "pattern": "Shipping\\s+Address[:\\s]*(.*?)(?:\\n\\n|Billing)",
      "required": false
    },
    "subtotal": {
      "method": "regex",
      "pattern": "Subtotal[:\\s]*(?:Rs\\.?|₹)?\\s*([\\d,]+\\.?\\d*)",
      "type": "number"
    },
    "shipping_charges": {
      "method": "regex",
      "pattern": "Shipping[:\\s]*(?:Rs\\.?|₹)?\\s*([\\d,]+\\.?\\d*)",
      "aliases": ["Delivery Charges"],
      "type": "number"
    },
    "total": {
      "method": "regex",
      "pattern": "(?:Total|Amount\\s+Payable)[:\\s]*(?:Rs\\.?|₹)?\\s*([\\d,]+\\.?\\d*)",
      "required": true,
      "type": "number"
    }
  },
  "table": {
    "detection": {
      "header_keywords": ["Product", "Qty", "Price"],
      "min_columns": 3
    },
    "columns": [
      {
        "name": "description",
        "aliases": ["Product", "Item", "Description"],
        "type": "string",
        "required": true
      },
      {
        "name": "quantity",
        "aliases": ["Qty", "Quantity"],
        "type": "number",
        "required": true
      },
      {
        "name": "unit_price",
        "aliases": ["Price", "Rate", "Unit Price"],
        "type": "number",
        "required": true
      },
      {
        "name": "total",
        "aliases": ["Amount", "Total"],
        "type": "number",
        "required": true
      }
    ]
  }
}
